{
    "name": "shardev/application",
    "description": "Application layer utilities for Shardev platform",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Shardevcom\\Application\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shardevcom\\Application\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "shardev/core": "@dev"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "laravel/framework": "^12.0",
        "symfony/console": "^7.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "minimum-stability": "dev",
        "prefer-stable": true
    },
    "extra": {
        "platform": {
            "provider": "Shardevcom\\Application\\ApplicationServiceProvider"
        },
        "laravel": {
            "providers": [
                "Shardevcom\\Application\\ApplicationServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
