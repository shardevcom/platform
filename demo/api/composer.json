{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/passport": "^13.0",
        "laravel/socialite": "^5.0",
        "laravel/tinker": "^2.10.1",
        "maatwebsite/excel": "^4.0",
        "nuwave/lighthouse": "^6.0",
        "pragmarx/google2fa-laravel": "^1.0",
        "shardev/documentation": "@dev",
        "web-auth/webauthn-lib": "^5.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Shardevcom\\Application\\": "packages/shardev/application/src/",
            "Shardevcom\\Authorization\\": "packages/shardev/authorization/src/",
            "Shardevcom\\Catalog\\": "packages/shardev/catalog/src/",
            "Shardevcom\\Communications\\": "packages/shardev/communications/src/",
            "Shardevcom\\Configuration\\": "packages/shardev/configuration/src/",
            "Shardevcom\\Core\\": "packages/shardev/core/src/",
            "Shardevcom\\Documentation\\": "packages/shardev/documentation/src/",
            "Shardevcom\\Graphql\\": "packages/shardev/graphql/src/",
            "Shardevcom\\Observability\\": "packages/shardev/observability/src/",
            "Shardevcom\\Persistence\\": "packages/shardev/persistence/src/",
            "Shardevcom\\Product\\": "packages/shardev/product/src/",
            "Shardevcom\\Resources\\": "packages/shardev/resources/src/",
            "Shardevcom\\Rest\\": "packages/shardev/rest/src/",
            "Shardevcom\\Security\\": "packages/shardev/security/src/",
            "Shardevcom\\Socialite\\": "packages/shardev/socialite/src/",
            "Shardevcom\\TwoFactor\\": "packages/shardev/twofactor/src/",
            "Shardevcom\\Widgets\\": "packages/shardev/widgets/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test:clear": [
            "@php artisan config:clear --ansi"
        ],
        "test:validate": [
            "@composer validate --no-check-publish"
        ],
        "test": [
            "@test:validate",
            "@test:clear",
            "@test:schema",
            "@php artisan test"
        ],
        "test:schema": "@php artisan lighthouse:clear-cache",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [{
        "name": "core",
        "type": "path",
        "url": "packages/shardev/core"
    },{
        "name": "documentation",
        "type": "path",
        "url": "packages/shardev/documentation"
    }]
}
