{
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowArbitraryExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@shardev/ui": ["packages/ui/src/index.ts"],
      "@shardev/ui/styles.css": ["packages/ui/src/styles.css"],
      "@shardev/core": ["packages/core/src/index.ts"],
      "@shardev/plugin-kit": ["packages/plugin-kit/src/index.ts"],
      "@plugins/product": ["plugins/product/src/index.ts"]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": ["apps", "packages", "plugins", "vite.shared.ts", "vite-env.d.ts"]
}
