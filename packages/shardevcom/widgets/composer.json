    "autoload": {
        "psr-4": {
            "Shardevcom\\Widgets\\": "src/"
        }
    },
    "extra": {
        "platform": {
            "provider": "Shardevcom\\Widgets\\WidgetsServiceProvider"
        }
    },
    "require": {
