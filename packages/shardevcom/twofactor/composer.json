{
    "name": "shardevcom/twofactor",
    "description": "Shardev platform Two-Factor Authentication (2FA) with TOTP support",
    "type": "platform-package",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Shardevcom\\TwoFactor\\": "src/"
        }
    },
    "extra": {
        "platform": {
            "provider": "Shardevcom\\TwoFactor\\TwoFactorServiceProvider"
        }
    },
    "require": {
        "php": "^8.3",
        "shardevcom/core": "@dev",
        "shardevcom/socialite": "@dev",
        "pragmarx/google2fa-laravel": "^1.0",
        "shardevcom/security": "@dev"
    }
}
